    {
      "id": "340a0c0a-042f-5782-abe7-4772dcef3755",
      "name": "Formatear digest",
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst rows = payload.anomalies || [];\nconst icon = { critical: '🔴', warn: '🟡', info: '🔵' };\n\nif (rows.length === 0) {\n  return [{ json: { text: '✅ Sin anomalías abiertas.' } }];\n}\n\nconst bySeverity = {};\nfor (const r of rows) (bySeverity[r.severity] ||= []).push(r);\n\nconst lines = [`*Anomalías abiertas: ${payload.count}*`];\nfor (const sev of ['critical', 'warn', 'info']) {\n  for (const r of bySeverity[sev] || []) {\n    lines.push(`${icon[sev]} ${r.kind} · ${r.rfc_emisor} · ${r.total} · ${r.invoice_uuid}`);\n  }\n}\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "position": [
        520,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "slackApi": {
          "name": "Slack account"
        }
      },
