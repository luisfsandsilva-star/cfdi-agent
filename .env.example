# ---- Postgres ----
POSTGRES_USER=cfdi
POSTGRES_PASSWORD=cfdi
POSTGRES_DB=cfdi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cfdi:cfdi@localhost:5432/cfdi

# ---- The company receiving the invoices ----
# Used by anomaly detector #8 (rfc_receptor mismatch) and by the agent's context.
COMPANY_RFC=XAXX010101000
COMPANY_NAME=Mi Empresa SA de CV

# ---- n8n ----
# Pin N8N_VERSION after first boot: docker compose exec n8n n8n --version
N8N_VERSION=latest
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=dev-only-change-me
# URL n8n uses to reach the FastAPI app. Inside Docker on Linux this is the
# host gateway; if you containerize the API too, use http://api:8000
API_BASE_URL=http://host.docker.internal:8000

# ---- LLM provider ----
# anthropic | local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=local (llama.cpp server on the AGX Orin)
LLM_BASE_URL=http://orin.local:8080/v1
EMBED_BASE_URL=http://orin.local:8082/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---- SAT status web service ----
# mock | live   (live hits ConsultaCFDIService.svc and needs network egress)
SAT_STATUS_MODE=mock

# ---- Slack ----
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#facturacion
